int nonDivisibleSubset(int k, vector<int> s) {
    vector<int> count(k, 0);

    for (int i = 0; i < s.size(); i++) {
        count[s[i] % k]++;
    }

    int ans = min(count[0], 1);

    for (int i = 1; i <= k / 2; i++) {
        if (i == k - i) {
            ans += min(count[i], 1);
        }
        else {
            ans += max(count[i], count[k - i]);
        }
    }

    return ans;
}
